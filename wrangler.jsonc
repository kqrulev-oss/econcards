// Cloudflare разворачивает весь репозиторий как один Worker: сайт (статика)
// и сервер (worker/worker.js) на одном адресе. Сервер получает только
// запросы к /ai, /packs/* и боту (/tg, /gh), всё остальное — файлы сайта.
// Имя совпадает с проектом в Cloudflare, иначе сборка не пройдёт.
{
  "name": "econcards",
  "main": "worker/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Нет такой страницы — 404.html с навигацией, а не пустой ответ (согласовано с владельцем 28.09.2026)
    "not_found_handling": "404-page",
    "run_worker_first": ["/ai", "/packs/*", "/tg", "/tg/*", "/gh", "/auth/*", "/me", "/me/*", "/pay/*"]
  },
  // Хранилище: если в панели уже привязано DB — используется оно, иначе создаётся
  "kv_namespaces": [{ "binding": "DB" }],
  // ИИ: Workers AI, бесплатный тариф, без ключа (согласовано с владельцем 28.09.2026)
  "ai": { "binding": "AI" },
  "vars": { "DAILY_LIMIT": "60" },
  // Бот: напоминания ученикам, отчёты родителям, сообщения репетиторам (worker/notify.js).
  // Раз в 5 минут; согласовано с владельцем 27.09.2026
  "triggers": { "crons": ["*/5 * * * *"] }
}
